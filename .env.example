# Copie ce fichier en .env et remplis les valeurs
#   cp .env.example .env

# Token HuggingFace (https://huggingface.co/settings/tokens)
# Nécessaire pour les modèles "gated" (accepter la licence sur la page du modèle avant).
HF_TOKEN=

# Registry où sont poussées les images pré-buildées (GitHub Container Registry)
# Format : ghcr.io/<ton-user-ou-org>
REGISTRY=ghcr.io/CHANGE_ME

# Tag d'image à déployer
TAG=latest
